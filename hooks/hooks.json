{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/detect-correction.js\"",
            "timeout": 5,
            "description": "Detects correction patterns in user prompts and logs them for rule extraction"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/notify-pending.js\"",
            "timeout": 5,
            "description": "Reminds about pending rules when Claude finishes a turn"
          }
        ]
      }
    ]
  }
}
