{
  "name": "claude-learner",
  "version": "2.2.0",
  "description": "🧠 Your AI that trains itself. MCP-native self-improving agent for Claude Code.",
  "main": "dist/index.js",
  "bin": {
    "claude-learner": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "daemon": "tsx src/daemon/server.ts",
    "mcp": "tsx src/mcp/server.ts",
    "prepublishOnly": "npm run build && chmod +x dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "keywords": [
    "claude",
    "claude-code",
    "mcp",
    "model-context-protocol",
    "ai",
    "llm",
    "learning",
    "cli",
    "productivity",
    "automation",
    "developer-tools",
    "claude-md",
    "self-improving",
    "agent"
  ],
  "author": "unisone (https://github.com/unisone)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unisone/claude-learner.git"
  },
  "bugs": {
    "url": "https://github.com/unisone/claude-learner/issues"
  },
  "homepage": "https://github.com/unisone/claude-learner#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@parcel/watcher": "^2.5.0",
    "better-sqlite3": "^11.7.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "glob": "^10.3.10",
    "ora": "^8.0.1",
    "zod": "^3.24.0"
  },
  "optionalDependencies": {
    "openai": "^4.77.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  }
}
