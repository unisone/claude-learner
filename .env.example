# Claude Learner Configuration

# OpenAI API Key (for pattern analysis)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Or use Anthropic directly
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: Custom Claude sessions path (defaults to ~/.claude/projects)
# CLAUDE_SESSIONS_PATH=/path/to/sessions
